{
  "name": "blank-front",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "test": "playwright test",
    "postinstall": "nuxt prepare",
    "format": "prettier --write \"app/**/*.{vue,ts,css}\" \"server/**/*.ts\" \"tests/**/*.ts\" nuxt.config.ts playwright.config.ts",
    "format:check": "prettier --check \"app/**/*.{vue,ts,css}\" \"server/**/*.ts\" \"tests/**/*.ts\" nuxt.config.ts playwright.config.ts"
  },
  "dependencies": {
    "nuxt": "4.6.1",
    "vue": "^3.5.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.0"
  },
  "overrides": {
    "simple-git": "4.0.2"
  }
}
